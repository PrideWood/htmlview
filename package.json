{
  "name": "classroom-photo-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node --check server.mjs && node --check lib/api.mjs && node --check public/app.js",
    "phone:pair": "node scripts/pair-phone.mjs",
    "phone:revoke": "node scripts/pair-phone.mjs --revoke"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@vercel/blob": "^2.0.0",
    "mammoth": "^1.13.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "pngjs": "^7.0.0"
  }
}
