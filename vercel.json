{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "version": 2,
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "public",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 300,
      "includeFiles": "{seed/**,lib/doc-worker.mjs}"
    }
  },
  "rewrites": [
    {
      "source": "/phone",
      "destination": "/phone.html"
    },
    {
      "source": "/phone/",
      "destination": "/phone.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?path=:path*"
    }
  ]
}
